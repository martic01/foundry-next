# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored; this example file (no real secrets) is the
# one meant to be committed. See the comments in .env.local (once you've
# copied it) for what each of these is and why it's safe/unsafe to expose.

NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
EMAILJS_PRIVATE_KEY=

# Use pk_test_.../sk_test_... keys first
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# From your Cloudinary dashboard (cloudinary.com -> Dashboard). The
# preset must be created with Signing Mode: Unsigned (Settings -> Upload
# -> Upload presets) -- see lib/cloudinary.js for why an unsigned preset
# is safe to expose here despite the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Direct download links for the two Windows installers (Installation
# page). Uploaded manually via Cloudinary's Media Library (drag-and-drop
# -- no upload preset needed for that, presets are only for the in-app
# unsigned uploader above), then paste each file's "secure URL" here.
# These are too large for GitHub (>50MB) to track directly, which is why
# they're not just files in public/ like everything else.
NEXT_PUBLIC_VSCODE_INSTALLER_URL=
NEXT_PUBLIC_GIT_INSTALLER_URL=

# SERVER-ONLY (no NEXT_PUBLIC_ prefix): used to delete a video from
# Cloudinary when the admin deletes it in the app. Cloudinary dashboard ->
# Settings -> API Keys. Never expose these to the browser.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Random string (e.g. `openssl rand -hex 32`). Protects /api/cron/purge,
# the daily job that deletes expired announcements, links and videos.
# Vercel sends it automatically as `Authorization: Bearer <value>`.
CRON_SECRET=
